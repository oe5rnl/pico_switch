        "${workspaceFolder}/../../WIZnet-PICO-C/libraries/pico-sdk/src/rp2_common/hardware_flash/include",
        "${workspaceFolder}/../../WIZnet-PICO-C/libraries/pico-sdk/src/rp2_common/hardware_gpio/include",
        "${workspaceFolder}/../../WIZnet-PICO-C/libraries/pico-sdk/src/rp2_common/hardware_sync/include",
        "${workspaceFolder}/../../WIZnet-PICO-C/libraries/pico-sdk/src/rp2_common/pico_platform_common/include",
        "${workspaceFolder}/../../WIZnet-PICO-C/libraries/pico-sdk/src/rp2350/hardware_regs/include",
