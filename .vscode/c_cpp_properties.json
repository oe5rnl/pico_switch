        "${workspaceFolder}/../../WIZnet-PICO-C/port/ioLibrary_Driver/inc"
      ],
      "defines": [
        "_WIZCHIP_=W6300",
        "DEVICE_BOARD_NAME=W6300_EVB_PICO2",
        "_WIZCHIP_QSPI_MODE_=QSPI_QUAD_MODE",
        "PICO_RP2350=1",
        "PICO_BOARD=\"pico2\""
      ],
      "intelliSenseMode": "linux-gcc-arm"
